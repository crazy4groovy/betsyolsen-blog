---
import Paragraphs from "./Paragraphs.astro";
import Nav from "./Nav.astro";

let { title, description, imgSrc, actionLabel, actionHref, actionHint } = Astro.props;
title = title.replace(/\n/g, "<br/>");
---

<header>
  <div class="mug" style={{ backgroundImage: `url("${imgSrc}")` }}>
    <a href="/">
      <img src="./images/white-text-logo.png" alt="Betsy Olsen" />
    </a>
  </div>
  <div class="body">
    <div class="nav-box">
      <Nav />
    </div>

    <h1 set:html={title}></h1>
    <div class="description">
      <Paragraphs text={description} />
    </div>
    {
      actionLabel && actionHref && (
        <div class="hero-action">
          <a class="button" href={actionHref}>{actionLabel}</a>
          {actionHint && <p>{actionHint}</p>}
        </div>
      )
    }
  </div>
</header>

<style>
  header {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
  }

  .mug {
    flex: 2;
    min-width: 200px;
    height: min(800px, 160vw);
    background-position: center center;
    background-size: cover;
  }
  .mug img {
    padding-top: 1rem;
    width: 50%;
    margin: auto;
  }

  .body {
    flex: 3;
    padding: clamp(2rem, 5vw, 5rem);
    align-self: center;
  }
  .body .nav-box {
    padding: 0;
  }
  .body h1 {
    text-align: left;
    margin: 2.5rem 0 1.5rem;
  }
  .body h1::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-bottom: 1.5rem;
    background-color: var(--accent);
  }
  .description {
    max-inline-size: 55ch;
  }
  .description :global(p) {
    padding-inline: 0;
  }
  .description :global(p + p) {
    margin-top: 1.5rem;
  }
  .hero-action {
    margin-top: 2rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.9rem 1.35rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    color: #fff;
    font-family: "Work Sans", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 150ms ease, border-color 150ms ease,
      transform 150ms ease;
  }
  .button:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    transform: translateY(-1px);
  }
  .hero-action p {
    margin: 0.75rem 0 0;
    padding: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .button:focus-visible,
  .mug a:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .mug {
      flex-basis: 100%;
      height: min(430px, 100vw);
    }
    .body h1 {
      margin-top: 2rem;
    }
  }
</style>
