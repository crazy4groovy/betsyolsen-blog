---
import BaseHead from "./BaseHead.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import BlogPostsList from "./BlogPostsList.astro";

const { posts = [], url } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body>
    <div class="nav-box">
      <Nav />
    </div>
    <main>
      <h1>Emerging Bravely</h1>
      <h3>WITH BETSY OLSEN</h3>
      <BlogPostsList posts={posts} />
      <div class="pagination">
        {
          url?.prev ? (
            <a href={url.prev} data-astro-prefetch>
              ⏪ Previous
            </a>
          ) : null
        }
        {
          url?.next ? (
            <a href={url.next} data-astro-prefetch>
              Next ⏩
            </a>
          ) : null
        }
      </div>
    </main>
    <Footer />
    <style>
      h1,
      h3 {
        max-inline-size: none;
        margin-top: 2rem;
        margin-bottom: 2rem;
      }
      h3 {
        font-size: 1rem;
        color: turquoise;
      }
      .pagination {
        display: flex;
        justify-content: space-evenly;
      }
    </style>
  </body>
</html>
