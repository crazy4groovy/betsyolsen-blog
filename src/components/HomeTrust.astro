---
const outcomes = [
  {
    number: "01",
    title: "Respond with more calm",
    description:
      "Make room between a difficult moment and your response, so overwhelm does not have to lead the conversation.",
  },
  {
    number: "02",
    title: "Trust your own decisions",
    description:
      "Build confidence in yourself and your parenting without needing to get every moment exactly right.",
  },
  {
    number: "03",
    title: "Feel more like yourself",
    description:
      "Find a steadier, more supportive way to move through motherhood, partnership, and everyday life.",
  },
];
---

<section class="trust" aria-labelledby="trust-heading">
  <div class="trust__intro">
    <p class="eyebrow">What coaching can support</p>
    <h2 id="trust-heading">A more grounded way forward.</h2>
    <p>
      One-on-one coaching gives you a compassionate space to understand what is
      creating the struggle and practice a different approach.
    </p>
  </div>

  <ol class="outcomes">
    {
      outcomes.map((outcome) => (
        <li>
          <span aria-hidden="true">{outcome.number}</span>
          <div>
            <h3>{outcome.title}</h3>
            <p>{outcome.description}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <figure class="featured-quote">
    <blockquote>
      “Betsy has an incredible ability to focus in on the thoughts that are
      creating all the drama in my life. I now see situations in a completely
      different light.”
    </blockquote>
    <figcaption>Robin H., Utah</figcaption>
  </figure>
</section>

<style>
  .trust {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 4vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    padding: 0;
    color: var(--accent-deep);
    font-family: "Work Sans", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .trust h2 {
    margin: 0;
    text-align: left;
  }

  .trust__intro > p:last-child {
    margin: 1.5rem 0 0;
    padding: 0;
    max-width: 42ch;
  }

  .outcomes {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcomes li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }

  .outcomes li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .outcomes span {
    color: var(--accent);
    font-family: "Work Sans", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .outcomes h3 {
    margin: 0;
    color: var(--ink-strong);
    font-family: "Work Sans", sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    text-align: left;
  }

  .outcomes p {
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .featured-quote {
    grid-column: 1 / -1;
    margin: clamp(1rem, 4vw, 3rem) 0 0;
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--ink-strong);
    color: #fff;
  }

  .featured-quote blockquote {
    max-width: 800px;
    margin: 0;
    color: inherit;
    border: 0;
    padding: 0;
    font-family: "Abril Fatface", serif;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-style: normal;
    line-height: 1.3;
  }

  .featured-quote figcaption {
    margin-top: 1.5rem;
    color: var(--surface-warm);
    font-family: "Work Sans", sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .trust {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .featured-quote {
      margin-top: 0;
    }
  }
</style>
