---
import { CALENDLY_URL } from "../config";

const {
  imgSrc = "/images/zhang-kaiyv-drip-unsplash-300x200.jpg",
  title = "Take the next gentle step.",
  description = "Book a gentle, no-pressure 30-minute consultation.",
  buttonLabel = "Book your consultation",
  buttonLink = CALENDLY_URL,
} = Astro.props;
---

<div class="wrapper">
  <div class="container">
    <div class="image">
      <img src={imgSrc} alt="Water droplet splashing into rippling water" loading="lazy" />
    </div>
    <div class="description">
      <h3>{title}</h3>
      {description && <p>{description}</p>}
      <a href={buttonLink}>{buttonLabel}</a>
    </div>
  </div>
</div>

<style>
  .wrapper {
    width: 100%;
    padding: clamp(2.5rem, 6vw, 4rem) 1rem;
    margin-top: 4rem;
    background-color: var(--surface-warm);
    border-block: 1px solid var(--rule);
  }
  .container {
    width: min(92vw, 620px);
    margin: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .container .image {
    text-align: center;
    flex: 1;
    padding: 1rem;
    min-width: 300px;
  }
  .container .image img {
    max-width: 100%;
    display: inline;
    box-shadow: 0 10px 30px -12px rgb(45 42 42 / 35%);
  }
  .container .description {
    flex: 2;
    padding: 1rem;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .container h3 {
    text-align: left;
  }
  .container p {
    padding-top: 2px;
  }
  .container a {
    display: block;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    color: #fff;
    border: 1px solid var(--accent-deep);
    background-color: var(--accent);
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    text-align: center;
    transition: background-color 150ms ease, box-shadow 150ms ease,
      transform 150ms ease;
  }
  .container a:hover {
    background-color: var(--accent-deep);
    box-shadow: 0 8px 18px -8px var(--accent-deep);
    transform: translateY(-1px);
  }
  .container a:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
</style>
