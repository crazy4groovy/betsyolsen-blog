---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
import BadgesForTLCS from "../components/BadgesForTLCS.astro";
import HomeTrust from "../components/HomeTrust.astro";
import { CALENDLY_URL } from "../config";

const title =
  "Are you ready to feel better so you can be the mom, wife, and woman you imagined you'd be?";

const description = [
  `You've come to the right place.
  I offer one-on-one coaching to help overwhelmed moms gain self-confidence in themselves and their parenting.`,
  `When you feel overwhelmed, extremely unhappy, and angry, it's hard to feel confident and successful in motherhood.
  With coaching, you will be able to feel confident and successful so you can be the mom, wife, and woman you know you want to be.`,
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body>
    <Header
      title={title}
      imgSrc={"./images/mug-leaves-and-breeze.jpg"}
      description={description}
      actionLabel="Book a 30-minute consultation"
      actionHref={CALENDLY_URL}
      actionHint="A gentle, no-pressure 30-minute call."
    />
    <main>
      <HomeTrust />
      <CTA />
      <BadgesForTLCS />
    </main>
    <Footer />
  </body>
</html>
